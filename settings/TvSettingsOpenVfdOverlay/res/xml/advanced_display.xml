<?xml version="1.0" encoding="utf-8"?>
<!--
  Replacement for com.android.tv.settings' res/xml/advanced_display.xml
  (Display & sound -> Advanced display settings), adding the front panel row
  that opens OpenVfdSettings' slice in the right pane. Same rules as
  device/rockchip/rk35xx-common's TvSettingsRockchipOverlay:

  * Only target resources are referenced (the strings re-declared in values/).
  * The upstream file's two EmbeddedSlicePreference rows are left out: they
    are custom:isPreferenceVisible="false" placeholders for GMS slices, and
    their custom: attributes do not compile in a standalone overlay.
  * The added row uses stock attributes only. SliceFragment reads its URI
    from the TAG_TARGET_URI argument, so a plain <extra> is enough.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/advanced_display_settings_title">

    <com.android.tv.settings.widget.SwitchWithSoundPreference
        android:key="game_mode"
        android:persistent="true"
        android:title="@string/game_mode_title"/>

    <Preference
        android:fragment="com.android.tv.settings.device.displaysound.PreferredDynamicRangeFragment"
        android:key="preferred_dynamic_range_selection"
        android:persistent="true"
        android:title="@string/preferred_dynamic_range_title"/>

    <Preference
        android:fragment="com.android.tv.settings.device.displaysound.HdrFormatSelectionFragment"
        android:key="hdr_format_selection"
        android:persistent="true"
        android:title="@string/hdr_format_selection_title"/>

    <Preference
        android:key="openvfd_settings"
        android:title="Front panel display"
        android:summary="Clock, brightness and status icons"
        android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment">
        <extra
            android:name="TAG_TARGET_URI"
            android:value="content://org.lineageos.openvfd.settings/main"/>
        <!-- No TAG_SCREEN_TITLE: the pane header comes from the slice's
             addScreenTitle, which OpenVfdSettings localizes. The row title
             and summary stay literals, since an overlay cannot add new
             resources referenced from a replaced file. -->
    </Preference>
</PreferenceScreen>
